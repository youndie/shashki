{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // The portfolio's shared configuration, extended by name: the timezone, the Monday schedule, the
  // limits, `platformAutomerge: false`, the kotlinx/sborka/ci-actions groups and majors going to a
  // human were identical in ten repositories and now live in sborka.
  //
  // The automerge preset is extended second on purpose — its rule has to land after the base
  // preset's "majors get a human" to override it for the harness — and its precondition holds
  // here: check.yaml runs on `pull_request`.
  extends: [
    "github>youndie/sborka",
    "github>youndie/sborka:automerge-harness",
  ],

  // REPEATED IN FULL, not added to: `ignorePaths` is replaced by this value rather than merged with
  // the preset's, so dropping the first two would un-ignore them.
  ignorePaths: ["**/build/**", "**/.gradle/**", "**/kotlin-js-store/**"],

  // Below the extends, so these win: package rules are concatenated, preset first, and the last
  // match takes effect.
  packageRules: [
    {
      // The catalog names runtime, foundation, ui and ui-test by coordinate rather than through
      // the plugin's accessors, and they have to land on one version: a newer foundation beside an
      // older sibling fails at RUNTIME inside a renderer, not at resolution.
      description: "Compose Multiplatform modules move as one version",
      matchPackageNames: [
        "/^org\\.jetbrains\\.compose[:.]/",
        "/^org\\.jetbrains\\.androidx\\./",
      ],
      groupName: "compose multiplatform",
    },
    // THIS REPOSITORY DECLARES NO KOTLIN, KTOR, KOIN OR KTLINT VERSION, AND THAT IS STILL TRUE.
    // The Kotlin plugins are applied by the sborka conventions and versioned by the shared `wip`
    // catalog; ktor and koin are named in the catalog as artefacts without a version, for the same
    // reason; ktlint arrives with `sborka.lint`, and what the build files spell is its
    // configuration block, not a dependency. They all move when sborka moves, in one pull request.
    // The preset does bring a `kotlin` group and the base preset's other rules — they match nothing
    // here, which costs nothing and is worth knowing before someone reads one as protection.
    {
      // kompot publishes a dozen coordinates under one version, and a half-moved set is the
      // failure mode. It also decides which Compose line this client can be on.
      description: "kompot is one release across every module it publishes",
      matchPackageNames: ["/^io\\.github\\.youndie:kompot-/"],
      groupName: "kompot",
    },
    {
      // THE GROUP WAS WRONG UNTIL NOW. This rule named `ru.workinprogress.shildik` while the
      // catalog pins `io.github.youndie.shildik:oidc-auth-server` and `:oidc-auth-core` — shildik
      // moved its group in 0.3.x — so the rule matched nothing and the halves it exists to keep
      // together were arriving as separate pull requests. Both names now, so the next move does
      // not repeat it.
      description: "shildik ships the shared model and both server halves under one version",
      matchPackageNames: [
        "/^io\\.github\\.youndie\\.shildik[:.]/",
        "/^ru\\.workinprogress\\.shildik[:.]/",
      ],
      groupName: "shildik",
    },
    {
      description: "Exposed: core, jdbc, json and the migration module are one version",
      matchPackageNames: ["/^org\\.jetbrains\\.exposed[:.]/"],
      groupName: "exposed",
    },
    {
      description: "Flyway: the engine and its Postgres module move together",
      matchPackageNames: ["/^org\\.flywaydb[:.]/"],
      groupName: "flyway",
    },
    {
      description: "cryptography-kotlin: core, random and the providers ship as one version",
      matchPackageNames: ["/^dev\\.whyoleg\\.cryptography[:.]/"],
      groupName: "cryptography-kotlin",
    },
    {
      description: "Base images: changing the JDK or the distro is a decision, not a bump",
      matchManagers: ["dockerfile"],
      automerge: false,
      // Own branch, so an image never shares a pull request with something that may automerge —
      // one dependency that may not holds back the whole PR. No check on a pull request builds
      // this file, so nothing here has run when the PR looks green.
      additionalBranchPrefix: "docker-",
    },
    {
      // `docker/compose.yaml` is a stand of our own services at the versions they were last known
      // to work together — shildik, bochka, booblik, metrik, tracy. Moving one of them is a
      // statement about the stand, and a tag there names a commit rather than a release line.
      description: "The local stand is pinned deliberately: a new tag is a decision, not a bump",
      matchManagers: ["docker-compose"],
      automerge: false,
      additionalBranchPrefix: "stand-",
      labels: ["dependencies", "test server"],
    },
    {
      // `image.tag` is empty on purpose — it means the chart's appVersion, which the image task
      // writes. Renovate filling it in would pin the chart to whatever tag existed the morning it
      // ran. Third-party images in this file stay tracked.
      description: "The chart names its own image; that version is not a dependency",
      matchManagers: ["helm-values"],
      matchPackageNames: ["shashki/server"],
      enabled: false,
    },
  ],
}
