{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  extends: ["config:recommended"],

  // Once a week, in UTC. Updates arrive as one Monday-morning batch rather than a trickle of a PR
  // a day — every pull request here runs the full check, and that build is not cheap.
  timezone: "Etc/UTC",
  schedule: ["before 6am on monday"],

  // Commits here are Conventional Commits, and a hook enforces it. `config:recommended` maps
  // dependency bumps to `fix:` and everything else to `chore:`.
  semanticCommits: "enabled",

  labels: ["dependencies"],

  // With the build harness merging itself these numbers stop being a throttle on human attention
  // and become one on runner time, so they can be higher.
  prConcurrentLimit: 5,
  prHourlyLimit: 0,

  // Renovate merges the pull request itself rather than arming GitHub's auto-merge: GitHub refuses
  // to arm it on a branch with no required checks, and adding branch protection to `main` would
  // change how this repository is worked in.
  platformAutomerge: false,

  // Vulnerabilities are the one thing that ignores the schedule.
  vulnerabilityAlerts: {
    schedule: ["at any time"],
    labels: ["dependencies", "security"],
  },

  ignorePaths: ["**/build/**", "**/.gradle/**", "**/kotlin-js-store/**"],

  packageRules: [
    {
      description: "Kotlin: the compiler and its plugins move as one version, and that is never a routine bump",
      matchPackageNames: ["/^org\\.jetbrains\\.kotlin[:.]/"],
      groupName: "kotlin",
    },
    {
      description: "kotlinx ships as one release train — one PR",
      matchPackageNames: ["/^org\\.jetbrains\\.kotlinx[:.]/"],
      groupName: "kotlinx",
    },
    {
      // The build conventions are one release published under two names: the catalog entry
      // `sborka` (the plugin coordinates) and the settings plugin id resolved in
      // settings.gradle.kts. Without this they arrive as two pull requests for one number, which
      // is what happens today in the repositories that migrated first.
      description: "sborka is one release, not one release per place it is named",
      matchPackageNames: ["/^ru\\.workinprogress\\.sborka/"],
      groupName: "sborka",
    },
    {
      // The catalog names runtime, foundation, ui and ui-test by coordinate rather than through
      // the plugin's accessors, and they have to land on one version: a newer foundation beside an
      // older sibling fails at RUNTIME inside a renderer, not at resolution.
      description: "Compose Multiplatform modules move as one version",
      matchPackageNames: [
        "/^org\\.jetbrains\\.compose[:.]/",
        "/^org\\.jetbrains\\.androidx\\./",
      ],
      groupName: "compose multiplatform",
    },
    {
      description: "Ktor: client and server modules share one version",
      matchPackageNames: ["/^io\\.ktor[:.]/"],
      groupName: "ktor",
    },
    {
      description: "Koin — one BOM, one version",
      matchPackageNames: ["/^io\\.insert-koin[:.]/"],
      groupName: "koin",
    },
    {
      description: "The build harness arrives as one PR, not one per action",
      matchManagers: ["github-actions"],
      groupName: "ci actions",
    },
    {
      description: "ktlint is build tooling, not a runtime dependency",
      matchPackageNames: [
        "/^org\\.jlleitschuh\\.gradle\\.ktlint[:.]/",
        "/^com\\.pinterest\\.ktlint[:.]/",
      ],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
    },
    {
      description: "Base images: changing the JDK or the distro is a decision, not a bump",
      matchManagers: ["dockerfile"],
      automerge: false,
      // Own branch, so an image never shares a pull request with something that may automerge —
      // one dependency that may not holds back the whole PR. No check on a pull request builds
      // this file, so nothing here has run when the PR looks green.
      additionalBranchPrefix: "docker-",
    },
    {
      // `docker/compose.yaml` is a stand of our own services at the versions they were last known
      // to work together — shildik, bochka, booblik, metrik, tracy. Moving one of them is a
      // statement about the stand, and a tag there names a commit rather than a release line.
      description: "The local stand is pinned deliberately: a new tag is a decision, not a bump",
      matchManagers: ["docker-compose"],
      automerge: false,
      additionalBranchPrefix: "stand-",
      labels: ["dependencies", "test server"],
    },
    {
      // `image.tag` is empty on purpose — it means the chart's appVersion, which the image task
      // writes. Renovate filling it in would pin the chart to whatever tag existed the morning it
      // ran. Third-party images in this file stay tracked.
      description: "The chart names its own image; that version is not a dependency",
      matchManagers: ["helm-values"],
      matchPackageNames: ["shashki/server"],
      enabled: false,
    },
    {
      description: "Majors of anything that ships get a human",
      matchUpdateTypes: ["major"],
      automerge: false,
      labels: ["dependencies", "major"],
    },
    // Last, so it wins over the major rule above. A major of `actions/checkout` is not the same
    // kind of event as a major of Ktor: the build harness is not shipped to anyone, and the check
    // that would catch a bad bump is the build itself — which already ran on the pull request.
    {
      description: "The build harness merges itself, majors included: CI on pull_request is the review",
      matchManagers: ["github-actions", "gradle-wrapper"],
      automerge: true,
      automergeType: "pr",
    },
  ],
}
